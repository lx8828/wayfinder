# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会进版本库。
# 离线测试与离线评测（first-agent eval）不需要任何密钥。

# --- LLM（chat / eval --real 需要）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 天气工具（可选：未配置时 get_weather 不注册）---
QWEATHER_API_KEY=
QWEATHER_HOST=

# --- 本地数据与 Trace ---
FIRST_AGENT_DB=var/agent.db
FIRST_AGENT_TRACE_DIR=var/traces
TRACE_MODE=safe
CALENDAR_PATH=var/calendar.json

# --- 记忆迁移（scripts/migrate_memory_v1.py）---
DEFAULT_USER_ID=demo
